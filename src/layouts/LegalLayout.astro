---
import Layout from './Layout.astro';
import { getCopy } from '../i18n/copy';

// Legal pages ship in English only this release; nav/footer render the EN copy.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const c = getCopy('en');
---

<Layout locale="en" c={c} title={title} description={description} homeAlternates={false}>
  <article class="legal-prose">
    <slot />
  </article>
</Layout>

<style is:global>
  .legal-prose {
    max-inline-size: 46rem;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 2rem);
    padding-block: clamp(7.5rem, 14vw, 10rem) clamp(4rem, 8vw, 6rem);
    color: var(--color-neutral-600);
    font-size: 1.02rem;
    line-height: 1.75;
  }
  .legal-prose h1 {
    margin: 0 0 1.5rem;
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-navy);
  }
  .legal-prose h2 {
    margin: 2.75rem 0 0.9rem;
    font-size: clamp(1.25rem, 2.4vw, 1.5rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }
  .legal-prose p {
    margin: 0 0 1.1rem;
  }
  .legal-prose ul {
    margin: 0 0 1.1rem;
    padding-inline-start: 1.4rem;
  }
  .legal-prose li {
    margin-block-end: 0.55rem;
  }
  .legal-prose strong {
    color: var(--color-neutral-700);
  }
  .legal-prose a {
    color: var(--color-action);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .legal-prose a:hover {
    color: var(--color-navy);
  }
  .legal-prose hr {
    border: none;
    border-block-start: 1px solid var(--color-neutral-100);
    margin-block: 2.5rem;
  }
</style>
