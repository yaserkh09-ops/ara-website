---
import '../styles/global.css';
// Self-hosted fonts (no third-party runtime calls). Browser fetches only the
// subsets actually used per page via unicode-range.
import '@fontsource-variable/inter/wght.css';
import '@fontsource/ibm-plex-sans-arabic/300.css';
import '@fontsource/ibm-plex-sans-arabic/400.css';
import '@fontsource/ibm-plex-sans-arabic/500.css';
import '@fontsource/ibm-plex-sans-arabic/600.css';
import '@fontsource/ibm-plex-sans-arabic/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';

import type { Copy, Locale } from '../i18n/copy';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  locale: Locale;
  c: Copy;
  /** Page-specific overrides (legal pages); default to the locale meta. */
  title?: string;
  description?: string;
  /** The hreflang alternates point at the two home routes — suppress on standalone pages. */
  homeAlternates?: boolean;
}

const { locale, c, homeAlternates = true } = Astro.props;
const { lang, dir } = c.meta;
const title = Astro.props.title ?? c.meta.title;
const description = Astro.props.description ?? c.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0C285D" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ARA Solutions · أرى" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_SA' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Alternate language versions (home routes only) -->
    {
      homeAlternates && (
        <>
          <link rel="alternate" hreflang="en" href={new URL('/', Astro.site).href} />
          <link rel="alternate" hreflang="ar" href={new URL('/ar/', Astro.site).href} />
          <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
        </>
      )
    }

    <!-- Add .js / .motion to <html> before paint: scopes reveal hidden-states
         so no-JS AND reduced-motion users always see full content (no FOUC). -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
            d.classList.add('motion');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{c.ui.skipToContent}</a>

    <SiteNav locale={locale} c={c} />

    <main id="main">
      <slot />
    </main>

    <SiteFooter locale={locale} c={c} />

    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>

    <style>
      .skip-link {
        position: fixed;
        inset-block-start: 0;
        inset-inline-start: 0;
        transform: translateY(-120%);
        z-index: 100;
        margin: 0.5rem;
        padding: 0.625rem 1rem;
        background: var(--color-navy);
        color: var(--color-white);
        border-radius: var(--radius-md);
        font-weight: 600;
        font-size: 0.95rem;
        box-shadow: var(--shadow-3);
        transition: transform 0.18s ease;
      }
      .skip-link:focus {
        transform: translateY(0);
        opacity: 1;
      }
    </style>
  </body>
</html>
