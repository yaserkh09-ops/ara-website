---
import type { Copy, Locale } from '../i18n/copy';
import { localeHome } from '../i18n/utils';

interface Props {
  locale: Locale;
  c: Copy;
}
const { locale, c } = Astro.props;

// Visual order is always EN then AR; the row mirrors to "AR / EN" in RTL.
const items: { code: Locale; label: string }[] = [
  { code: 'en', label: c.nav.toggle.en },
  { code: 'ar', label: c.nav.toggle.ar },
];
---

<div class="langtoggle" role="group" aria-label={c.ui.toFromLabel}>
  {
    items.map((item) =>
      item.code === locale ? (
        <span class="langtoggle__opt is-active" aria-current="true">
          {item.label}
        </span>
      ) : (
        <a
          class="langtoggle__opt no-fade"
          href={localeHome(item.code)}
          data-locale-switch
          aria-label={c.ui.switchToOtherAria}
          hreflang={item.code}
        >
          {item.label}
        </a>
      )
    )
  }
</div>

<style>
  .langtoggle {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
  }
  .langtoggle__opt {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.1rem;
    padding-block: 0.3rem;
    padding-inline: 0.55rem;
    border-radius: var(--radius-full);
    color: rgba(255, 255, 255, 0.7);
    font-weight: 500;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .langtoggle__opt.is-active {
    background: var(--color-action);
    color: var(--color-white);
  }
  .langtoggle__opt:not(.is-active):hover {
    color: var(--color-white);
    background: rgba(255, 255, 255, 0.08);
  }
</style>
