---
// The signature motif: "the shelf becomes visible."
// A floating "Live inventory" product panel — an organization and a company
// connect, greyed stock tiles light up to live status, and one tile ticks
// amber -> green on a slow loop.
//
// Rendered in its FINAL lit state by default (visible without JS / reduced
// motion). motion.ts dims it then plays the orchestrated entrance.
import type { Copy } from '../i18n/copy';
interface Props {
  c: Copy;
}
const { c } = Astro.props;
const m = c.ui.motif;

// Sample system data (Western mono digits — reads as real system data, per spec).
const tiles = [
  { sku: 'SKU-4821', qty: '142', status: 'in' },
  { sku: 'SKU-1907', qty: '38', status: 'low', restock: true },
  { sku: 'SKU-7233', qty: '0', status: 'out' },
  { sku: 'SKU-5560', qty: '210', status: 'in' },
  { sku: 'SKU-3094', qty: '76', status: 'in' },
  { sku: 'SKU-2418', qty: '12', status: 'low' },
];
const statusLabel: Record<string, string> = {
  in: m.inStock,
  low: m.low,
  out: m.out,
};
---

<div id="hero-motif" class="motif" role="img" aria-label={m.caption} data-motif>
  <div class="motif__glow glow" aria-hidden="true"></div>

  <div class="motif__panel grain">
    <!-- window chrome / header -->
    <div class="motif__bar">
      <span class="motif__dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span class="motif__bar-title">{m.panelTitle}</span>
      <span class="motif__live"><span class="motif__live-dot"></span>{m.liveLabel}</span>
    </div>

    <!-- connection between the two parties -->
    <div class="motif__flow">
      <span class="motif__node motif__node--org" data-node>
        <span class="motif__node-dot"></span>{m.org}
      </span>
      <svg class="motif__wire" viewBox="0 0 200 24" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M 4 12 H 196"
          fill="none"
          stroke="url(#motifWire)"
          stroke-width="2"
          stroke-linecap="round"
          data-connector
        ></path>
        <defs>
          <linearGradient id="motifWire" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#28CDFC"></stop>
            <stop offset="50%" stop-color="#0673FF"></stop>
            <stop offset="100%" stop-color="#F05A29"></stop>
          </linearGradient>
        </defs>
      </svg>
      <span class="motif__node motif__node--company" data-node>
        <span class="motif__node-dot"></span>{m.company}
      </span>
    </div>

    <ul class="motif__grid">
      {
        tiles.map((t) => (
          <li
            class="motif__tile"
            data-tile
            data-status={t.status}
            data-restock={t.restock ? 'true' : undefined}
          >
            <span class="motif__tile-head">
              <span class="motif__sku tnum">{t.sku}</span>
              <span class="motif__status-dot" data-dot></span>
            </span>
            <span class="motif__qty tnum" data-qty>{t.qty}</span>
            <span class="motif__status-label" data-status-label>{statusLabel[t.status]}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .motif {
    position: relative;
    inline-size: 100%;
    max-inline-size: 36rem;
    margin-inline: auto;
  }
  .motif__glow {
    inline-size: 26rem;
    block-size: 26rem;
    background: radial-gradient(circle, rgba(40, 205, 252, 0.28), transparent 70%);
    inset-block-start: -6rem;
    inset-inline-end: -5rem;
    z-index: 0;
  }

  /* Floating product panel */
  .motif__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    z-index: 1;
    padding: clamp(1rem, 2.2vw, 1.4rem);
    border-radius: var(--radius-bento);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.04));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      var(--shadow-3),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(16px) saturate(130%);
    -webkit-backdrop-filter: blur(16px) saturate(130%);
  }
  .motif__panel::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    height: 1px;
    background-image: var(--grad-signature);
    opacity: 0.8;
    z-index: 2;
  }

  /* header */
  .motif__bar {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block-end: 0.9rem;
    margin-block-end: 1rem;
    border-block-end: 1px solid rgba(255, 255, 255, 0.08);
  }
  .motif__dots {
    display: inline-flex;
    gap: 0.32rem;
  }
  .motif__dots span {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.22);
  }
  .motif__bar-title {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.62);
    margin-inline-start: 0.2rem;
  }
  :global([dir='rtl']) .motif__bar-title {
    font-family: var(--font-arabic);
  }
  .motif__live {
    margin-inline-start: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-success);
  }
  :global([dir='rtl']) .motif__live {
    font-family: var(--font-arabic);
    text-transform: none;
    letter-spacing: 0;
  }
  .motif__live-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 9999px;
    background: var(--color-success);
    box-shadow: 0 0 0 0 rgba(29, 184, 122, 0.5);
    animation: motifPulse 2.4s ease-out infinite;
  }
  @keyframes motifPulse {
    0% { box-shadow: 0 0 0 0 rgba(29, 184, 122, 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(29, 184, 122, 0); }
    100% { box-shadow: 0 0 0 0 rgba(29, 184, 122, 0); }
  }

  /* nodes + connector */
  .motif__flow {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 1.1rem;
  }
  .motif__node {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block: 0.45rem;
    padding-inline: 0.8rem;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: var(--color-white);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    letter-spacing: 0.02em;
    box-shadow: var(--shadow-1);
    white-space: nowrap;
  }
  :global([dir='rtl']) .motif__node {
    font-family: var(--font-arabic);
  }
  .motif__node-dot {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 9999px;
    background: var(--color-sky);
    box-shadow: 0 0 10px rgba(40, 205, 252, 0.9);
  }
  .motif__node--company .motif__node-dot {
    background: var(--color-orange);
    box-shadow: 0 0 10px rgba(240, 90, 41, 0.8);
  }
  .motif__wire {
    inline-size: 100%;
    block-size: 1.5rem;
    opacity: 0.95;
  }

  /* tile grid */
  .motif__grid {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.65rem;
  }
  @media (min-width: 420px) {
    .motif__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .motif__tile {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 0.8rem 0.85rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.05));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      var(--shadow-1),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: filter 0.6s ease, opacity 0.6s ease, transform 0.3s var(--ease-out-quint);
  }
  .motif__tile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .motif__sku {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.03em;
    color: rgba(255, 255, 255, 0.72);
  }
  .motif__status-dot {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 9999px;
    flex: 0 0 auto;
  }
  .motif__qty {
    font-family: var(--font-mono);
    font-size: 1.55rem;
    font-weight: 600;
    color: var(--color-white);
    line-height: 1;
  }
  .motif__status-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgba(255, 255, 255, 0.6);
  }
  :global([dir='rtl']) .motif__status-label,
  :global([dir='rtl']) .motif__sku {
    font-family: var(--font-mono);
    text-transform: none;
    letter-spacing: 0;
  }

  /* Status colors (final lit state = default) */
  .motif__tile[data-status='in'] .motif__status-dot {
    background: var(--color-success);
    box-shadow: 0 0 12px rgba(29, 184, 122, 0.85);
  }
  .motif__tile[data-status='in'] .motif__status-label {
    color: var(--color-success);
  }
  .motif__tile[data-status='low'] .motif__status-dot {
    background: var(--color-warning);
    box-shadow: 0 0 12px rgba(245, 166, 35, 0.85);
  }
  .motif__tile[data-status='low'] .motif__status-label {
    color: var(--color-warning);
  }
  .motif__tile[data-status='out'] .motif__status-dot {
    background: var(--color-danger);
    box-shadow: 0 0 12px rgba(239, 68, 68, 0.85);
  }
  .motif__tile[data-status='out'] .motif__status-label {
    color: var(--color-danger);
  }

  /* Dimmed / "hidden data" state, applied only while motion plays. */
  .motif.is-dim .motif__tile {
    filter: grayscale(1) brightness(0.7);
    opacity: 0.5;
  }
  .motif.is-dim .motif__tile .motif__status-dot {
    background: var(--color-neutral-400) !important;
    box-shadow: none !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .motif__live-dot {
      animation: none;
    }
  }
</style>
