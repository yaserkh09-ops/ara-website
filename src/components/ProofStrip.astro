---
// Slim, honest value strip — short claims pulled from the locked copy.
// No fabricated metrics or logos; structure is ready for real proof later.
import type { Copy } from '../i18n/copy';
interface Props {
  c: Copy;
}
const { c } = Astro.props;
const items = c.ui.proof;
---

<aside class="proof" aria-label={c.solution.eyebrow}>
  <div class="proof__inner">
    <ul class="proof__list" data-reveal-group>
      {
        items.map((item) => (
          <li class="proof__item" data-reveal>
            <span class="proof__dot" aria-hidden="true" />
            <span class="proof__label">{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .proof {
    background: var(--color-bg-light);
    border-block-end: 1px solid var(--color-neutral-100);
  }
  .proof__inner {
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
    padding-block: clamp(1.1rem, 2.4vw, 1.6rem);
  }
  .proof__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem 2rem;
  }
  .proof__item {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    position: relative;
  }
  /* thin separators between items on wide screens */
  .proof__item + .proof__item::before {
    content: '';
    position: absolute;
    inset-inline-start: -1rem;
    inset-block: 0.1rem;
    inline-size: 1px;
    background: var(--color-neutral-200);
  }
  .proof__dot {
    inline-size: 0.48rem;
    block-size: 0.48rem;
    border-radius: 9999px;
    background-image: var(--grad-text);
    box-shadow: 0 0 8px rgba(40, 205, 252, 0.45);
    flex: 0 0 auto;
  }
  .proof__label {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.01em;
    color: var(--color-neutral-600);
    white-space: nowrap;
  }
  :global([dir='rtl']) .proof__label {
    font-family: var(--font-arabic);
    font-weight: 500;
  }

  @media (max-width: 560px) {
    .proof__list {
      gap: 0.7rem 1.25rem;
    }
    .proof__item + .proof__item::before {
      display: none;
    }
    .proof__label {
      font-size: 0.76rem;
      white-space: normal;
    }
  }
</style>
