---
// Link-styled button. Variants: primary (solid action-blue) | ghost (outline).
// `tone` adapts the ghost variant to light vs navy backgrounds.
interface Props {
  href: string;
  variant?: 'primary' | 'ghost';
  tone?: 'light' | 'navy';
  external?: boolean;
  class?: string;
  id?: string;
  'data-jump'?: string;
}
const {
  href,
  variant = 'primary',
  tone = 'light',
  external = false,
  class: className = '',
  id,
  ...rest
} = Astro.props;

const ext = external
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---

<a
  href={href}
  id={id}
  class:list={['btn no-fade', `btn--${variant}`, `btn--${tone}`, className]}
  {...ext}
  {...rest}
>
  <span class="btn__label"><slot /></span>
</a>

<style>
  .btn {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding-block: 0.9rem;
    padding-inline: 1.7rem;
    border-radius: var(--radius-full);
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1;
    letter-spacing: -0.005em;
    border: 1px solid transparent;
    cursor: pointer;
    transition:
      transform 0.35s var(--ease-out-quint),
      box-shadow 0.35s var(--ease-out-quint),
      background-color 0.25s ease,
      border-color 0.25s ease,
      filter 0.25s ease,
      color 0.25s ease;
    white-space: nowrap;
  }
  .btn__label {
    position: relative;
    z-index: 1;
  }
  :global([dir='rtl']) .btn {
    font-family: var(--font-arabic);
  }

  .btn:hover {
    transform: translateY(-2px);
  }
  .btn:active {
    transform: translateY(0);
  }

  /* Primary — action blue with a subtle vertical sheen + blue glow */
  .btn--primary {
    background-image: linear-gradient(
      180deg,
      color-mix(in srgb, var(--color-action) 84%, #ffffff) 0%,
      var(--color-action) 58%,
      color-mix(in srgb, var(--color-action) 92%, #000000) 100%
    );
    color: var(--color-white);
    box-shadow: var(--shadow-action);
  }
  .btn--primary::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0) 46%);
    opacity: 0.7;
    pointer-events: none;
  }
  .btn--primary:hover {
    box-shadow: var(--shadow-action-hover);
    filter: brightness(1.04) saturate(1.04);
  }

  /* Ghost on light */
  .btn--ghost.btn--light {
    background-color: transparent;
    color: var(--color-navy);
    border-color: var(--color-neutral-200);
  }
  .btn--ghost.btn--light:hover {
    border-color: var(--color-action);
    color: var(--color-action);
    box-shadow: var(--shadow-1);
  }

  /* Ghost on navy */
  .btn--ghost.btn--navy {
    background-color: rgba(255, 255, 255, 0.04);
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.28);
  }
  .btn--ghost.btn--navy:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.55);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn:hover,
    .btn:active {
      transform: none;
    }
  }
</style>
