---
// §6 trust pillar — quiet glass cell on navy with an understated line icon.
interface Props {
  icon: 'own' | 'access' | 'current';
  title: string;
  body: string;
  emphasis?: boolean;
  class?: string;
}
const { icon, title, body, emphasis = false, class: className = '' } = Astro.props;
---

<article class:list={['glass pillar', { 'pillar--emphasis': emphasis }, className]} data-reveal>
  <span class="pillar__icon" aria-hidden="true">
    {icon === 'own' && (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6l7-3z" />
        <path d="M9.5 12.2l1.8 1.8 3.4-3.6" />
      </svg>
    )}
    {icon === 'access' && (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="9" cy="9" r="3" />
        <path d="M2.5 19a6.5 6.5 0 0 1 13 0" />
        <path d="M16 8h5M19 5.5v5" />
      </svg>
    )}
    {icon === 'current' && (
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20 11a8 8 0 1 0-1.1 5" />
        <path d="M20 5v4h-4" />
      </svg>
    )}
  </span>
  <h3 class="pillar__title">{title}</h3>
  <p class="pillar__body">{body}</p>
</article>

<style>
  .pillar {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: clamp(1.5rem, 2.8vw, 2.25rem);
    color: var(--color-white);
    block-size: 100%;
    transition:
      transform 0.4s var(--ease-out-quint),
      box-shadow 0.4s var(--ease-out-quint),
      border-color 0.3s ease;
  }
  .pillar:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-3), 0 0 0 1px rgba(40, 205, 252, 0.22);
    border-color: rgba(40, 205, 252, 0.32);
  }
  .pillar__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-md);
    background: rgba(40, 205, 252, 0.12);
    color: var(--color-sky);
    border: 1px solid rgba(40, 205, 252, 0.22);
  }
  .pillar__title {
    margin: 0;
    font-size: clamp(1.15rem, 1.9vw, 1.45rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-white);
  }
  .pillar__body {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.74);
  }

  @media (prefers-reduced-motion: reduce) {
    .pillar:hover {
      transform: none;
    }
  }
</style>
