---
// §4 audience card — one card per named solution; the audience line sits
// above the solution name. The organizations cell is the weighted one.
interface Props {
  label: string; // audience kicker ("For healthcare organizations")
  solution: string; // solution name (card title)
  body: string;
  emphasis?: boolean;
  tag: string;
  icon: 'org' | 'company';
  class?: string;
}
const { label, solution, body, emphasis = false, tag, icon, class: className = '' } = Astro.props;
---

<article
  class:list={['acard', { 'acard--emphasis': emphasis }, className]}
  data-reveal
>
  <div class="acard__top">
    <span class="acard__icon" aria-hidden="true">
      {icon === 'org' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 21V6l7-3 7 3v15" />
          <path d="M4 21h16" />
          <path d="M11 8.5v4M9 10.5h4" />
          <path d="M9 21v-3.5h4V21" />
        </svg>
      )}
      {icon === 'company' && (
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 8.5 12 4l9 4.5-9 4.5-9-4.5Z" />
          <path d="M3 8.5V16l9 4.5 9-4.5V8.5" />
          <path d="M12 13v7.5" />
        </svg>
      )}
    </span>
    <span class="acard__tag tnum">{tag}</span>
  </div>
  <div class="acard__titles">
    <p class="acard__kicker">{label}</p>
    <h3 class="acard__label">{solution}</h3>
  </div>
  <p class="acard__body">{body}</p>
  <span class="acard__bar grad-signature" aria-hidden="true"></span>
</article>

<style>
  .acard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-block-size: clamp(15rem, 24vw, 19rem);
    padding: clamp(1.9rem, 3.4vw, 3rem);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-bento);
    box-shadow: var(--shadow-card);
    block-size: 100%;
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-out-quint),
      box-shadow 0.45s var(--ease-out-quint),
      border-color 0.3s ease;
  }
  .acard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-neutral-200);
  }
  .acard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .acard__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 3rem;
    block-size: 3rem;
    border-radius: var(--radius-lg);
    color: var(--color-action);
    background: color-mix(in srgb, var(--color-action) 9%, #fff);
    border: 1px solid color-mix(in srgb, var(--color-action) 18%, #fff);
  }
  .acard--emphasis .acard__icon {
    color: var(--color-navy);
    background: color-mix(in srgb, var(--color-navy) 7%, #fff);
    border-color: color-mix(in srgb, var(--color-navy) 16%, #fff);
  }
  .acard__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-action);
  }
  :global([dir='rtl']) .acard__tag {
    font-family: var(--font-arabic);
    text-transform: none;
    letter-spacing: 0;
  }
  .acard__titles {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .acard__kicker {
    margin: 0;
    font-size: 0.88rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--color-action);
  }
  .acard__label {
    margin: 0;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }
  .acard__body {
    margin: 0;
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-neutral-600);
  }
  .acard__bar {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 3px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .acard:hover .acard__bar,
  .acard--emphasis .acard__bar {
    opacity: 1;
  }
  .acard--emphasis {
    border-color: var(--color-neutral-200);
    box-shadow: var(--shadow-card-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .acard:hover {
      transform: none;
    }
  }
</style>
