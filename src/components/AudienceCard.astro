---
// §4 audience card. The organizations cell is the weighted (priority) one.
interface Props {
  label: string;
  body: string;
  emphasis?: boolean;
  tag: string;
  class?: string;
}
const { label, body, emphasis = false, tag, class: className = '' } = Astro.props;
---

<article
  class:list={['acard', { 'acard--emphasis': emphasis }, className]}
  data-reveal
>
  <span class="acard__tag tnum">{tag}</span>
  <h3 class="acard__label">{label}</h3>
  <p class="acard__body">{body}</p>
  <span class="acard__bar grad-signature" aria-hidden="true"></span>
</article>

<style>
  .acard {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(1.75rem, 3.2vw, 2.75rem);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-bento);
    box-shadow: var(--shadow-card);
    block-size: 100%;
    overflow: hidden;
    transition:
      transform 0.45s var(--ease-out-quint),
      box-shadow 0.45s var(--ease-out-quint),
      border-color 0.3s ease;
  }
  .acard:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-neutral-200);
  }
  .acard__tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-action);
  }
  :global([dir='rtl']) .acard__tag {
    font-family: var(--font-arabic);
    text-transform: none;
    letter-spacing: 0;
  }
  .acard__label {
    margin: 0;
    font-size: clamp(1.3rem, 2.2vw, 1.85rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-navy);
  }
  .acard__body {
    margin: 0;
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: var(--color-neutral-600);
  }
  .acard__bar {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 3px;
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .acard:hover .acard__bar,
  .acard--emphasis .acard__bar {
    opacity: 1;
  }
  .acard--emphasis {
    border-color: var(--color-neutral-200);
    box-shadow: var(--shadow-card-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .acard:hover {
      transform: none;
    }
  }
</style>
