---
import type { Copy, Locale } from '../../i18n/copy';
import { site } from '../../i18n/copy';
import Section from '../Section.astro';
import Button from '../Button.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { c } = Astro.props;
---

<Section id={site.anchors.cta} theme="navy" glow innerClass="cta__inner">
  <div class="cta" data-reveal-group>
    <h2 class="cta__heading" data-reveal>{c.cta.heading}</h2>
    <span class="cta__bar grad-signature" aria-hidden="true" data-reveal></span>
    <p class="cta__body" data-reveal>{c.cta.body}</p>
    <div class="cta__actions" data-reveal>
      <Button href={site.signInUrl} variant="primary" external>{c.cta.primary}</Button>
      <Button href={site.contactHref} variant="ghost" tone="navy">{c.cta.secondary}</Button>
    </div>
  </div>
</Section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    max-inline-size: 46rem;
    margin-inline: auto;
  }
  .cta__heading {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-white);
    text-wrap: balance;
  }
  .cta__bar {
    block-size: 3px;
    inline-size: clamp(7rem, 22vw, 12rem);
    border-radius: 3px;
    margin-block: 1.75rem;
  }
  .cta__body {
    margin: 0;
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-block-start: 2.25rem;
  }
</style>
