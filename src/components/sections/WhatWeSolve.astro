---
import type { Copy, Locale } from '../../i18n/copy';
import { site } from '../../i18n/copy';
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';
import GlassCard from '../GlassCard.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { c } = Astro.props;

const accents = ['sky', 'warning', 'danger'] as const;
---

<Section id={site.anchors.whatWeSolve} theme="light">
  <div class="solve__head">
    <Eyebrow text={c.problem.eyebrow} />
    <h2 class="solve__heading" data-reveal>{c.problem.heading}</h2>
    <p class="solve__body" data-reveal>{c.problem.body}</p>
  </div>

  <!-- Pain points on a navy mini-panel, bento (patient-impact card weighted) -->
  <div class="solve__panel on-navy grain">
    <div class="solve__panel-atmos" aria-hidden="true">
      <span class="glow solve__glow"></span>
    </div>
    <div class="solve__bento" data-reveal-group>
      {
        c.problem.points.map((p, i) => (
          <GlassCard
            index={`0${i + 1}`}
            title={p.title}
            body={p.body}
            accent={accents[i]}
            emphasis={i === 2}
            class={i === 2 ? 'solve__cell--wide' : ''}
          />
        ))
      }
    </div>
  </div>
</Section>

<style>
  .solve__head {
    max-inline-size: 52rem;
    margin-block-end: clamp(2.5rem, 5vw, 3.5rem);
  }
  .solve__heading {
    margin: 1.25rem 0 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-neutral-700);
    text-wrap: balance;
  }
  .solve__body {
    margin: 1.5rem 0 0;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.7;
    color: var(--color-neutral-600);
  }

  .solve__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-bento);
    background-image:
      radial-gradient(110% 80% at 12% -10%, rgba(40, 205, 252, 0.12), transparent 55%),
      var(--grad-navy);
    padding: clamp(1.75rem, 3.5vw, 3rem);
    box-shadow: var(--shadow-3);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .solve__glow {
    inline-size: 28rem;
    block-size: 28rem;
    background: radial-gradient(circle, rgba(6, 115, 255, 0.18), transparent 70%);
    inset-block-start: -12rem;
    inset-inline-end: -8rem;
    z-index: 0;
  }
  .solve__bento {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  /* Bento: on wider screens the patient-impact card spans both columns. */
  @media (min-width: 720px) {
    .solve__bento {
      grid-template-columns: repeat(2, 1fr);
    }
    .solve__cell--wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1040px) {
    .solve__bento {
      grid-template-columns: repeat(3, 1fr);
    }
    /* patient-impact becomes the wide feature strip on the bottom row */
    .solve__cell--wide {
      grid-column: 1 / -1;
    }
  }
</style>
