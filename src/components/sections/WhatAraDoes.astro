---
import type { Copy, Locale } from '../../i18n/copy';
import { site } from '../../i18n/copy';
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';
import ProductPanel from '../ProductPanel.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { c } = Astro.props;
---

<Section id={site.anchors.whatAraDoes} theme="light">
  <div class="does__head">
    <Eyebrow text={c.solution.eyebrow} />
    <h2 class="does__heading" data-reveal>{c.solution.heading}</h2>
    <p class="does__body" data-reveal>{c.solution.body}</p>
  </div>

  <div class="does__bento">
    <!-- Feature cell: the locked -> live mechanism -->
    <div class="does__feature on-navy grain" data-reveal>
      <ProductPanel c={c} />
    </div>

    <!-- Small value cells -->
    <ul class="does__values" data-reveal>
      {
        c.solution.values.map((v, i) => (
          <li class="does__value">
            <span class="does__value-index tnum">{`0${i + 1}`}</span>
            <span class="does__value-label">{v.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Section>

<style>
  .does__head {
    max-inline-size: 52rem;
    margin-block-end: clamp(2.5rem, 5vw, 3.5rem);
  }
  .does__heading {
    margin: 1.25rem 0 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-neutral-700);
    text-wrap: balance;
  }
  .does__body {
    margin: 1.5rem 0 0;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.7;
    color: var(--color-neutral-600);
  }

  .does__bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  .does__feature {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: var(--radius-bento);
    background-image:
      radial-gradient(120% 90% at 88% -10%, rgba(40, 205, 252, 0.16), transparent 55%),
      var(--grad-navy);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    box-shadow: var(--shadow-3);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }

  .does__values {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
  }
  .does__value {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--color-white);
    border: 1px solid var(--color-neutral-100);
    border-radius: var(--radius-bento);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.45s var(--ease-out-quint),
      box-shadow 0.45s var(--ease-out-quint),
      border-color 0.3s ease;
  }
  .does__value:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--color-neutral-200);
  }
  .does__value-index {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    color: var(--color-action);
  }
  .does__value-label {
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    font-weight: 700;
    color: var(--color-neutral-700);
    line-height: 1.2;
  }

  @media (min-width: 980px) {
    .does__bento {
      grid-template-columns: 1.25fr 0.75fr;
      align-items: stretch;
    }
    .does__values {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
    .does__value {
      flex: 1;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .does__value:hover {
      transform: none;
    }
  }
</style>
