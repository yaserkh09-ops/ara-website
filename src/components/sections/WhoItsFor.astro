---
import type { Copy, Locale } from '../../i18n/copy';
import { site } from '../../i18n/copy';
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';
import AudienceCard from '../AudienceCard.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { c } = Astro.props;
---

<Section id={site.anchors.whoItsFor} theme="light" vignette>
  <div class="who__head">
    <Eyebrow text={c.audiences.eyebrow} />
    <h2 class="who__heading" data-reveal>{c.audiences.heading}</h2>
  </div>

  <div class="who__bento" data-reveal-group>
    <AudienceCard
      tag="01"
      icon="org"
      label={c.audiences.organizations.label}
      body={c.audiences.organizations.body}
      emphasis
      class="who__cell--org"
    />
    <AudienceCard
      tag="02"
      icon="company"
      label={c.audiences.companies.label}
      body={c.audiences.companies.body}
      class="who__cell--co"
    />
  </div>
</Section>

<style>
  .who__head {
    max-inline-size: 52rem;
    margin-block-end: clamp(2.5rem, 5vw, 3.5rem);
  }
  .who__heading {
    margin: 1.25rem 0 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-neutral-700);
    text-wrap: balance;
  }

  .who__bento {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  /* Two-cell bento — organizations (priority) gets more weight. */
  @media (min-width: 860px) {
    .who__bento {
      grid-template-columns: 1.25fr 0.75fr;
      align-items: stretch;
    }
  }
</style>
