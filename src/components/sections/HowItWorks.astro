---
import type { Copy, Locale } from '../../i18n/copy';
import { site } from '../../i18n/copy';
import Section from '../Section.astro';
import Eyebrow from '../Eyebrow.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { c } = Astro.props;
---

<Section id={site.anchors.howItWorks} theme="light" vignette class="how-section">
  <div class="how__head">
    <Eyebrow text={c.how.eyebrow} />
    <h2 class="how__heading" data-reveal>{c.how.heading}</h2>
  </div>

  <div id="how-pin" class="how" data-how>
    <!-- Connected-flow rail -->
    <div class="how__rail" aria-hidden="true">
      <div class="how__rail-line"><span class="how__rail-fill" data-flow-fill></span></div>
      {
        c.how.steps.map((s, i) => (
          <div class="how__rail-node" data-flow-node data-index={i}>
            <span class="how__rail-num tnum">{s.n}</span>
          </div>
        ))
      }
    </div>

    <!-- Step panels -->
    <ol class="how__steps">
      {
        c.how.steps.map((s, i) => (
          <li class="how__step" data-step data-index={i}>
            <span class="how__step-eyebrow tnum">
              {c.how.stepWord} {s.n}
            </span>
            <h3 class="how__step-title">{s.title}</h3>
            <p class="how__step-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</Section>

<style>
  /* Allow the pinned step-through to work without clipping. */
  :global(.section.how-section) {
    overflow: visible;
  }

  .how__head {
    max-inline-size: 52rem;
    margin-block-end: clamp(2.5rem, 5vw, 3.5rem);
  }
  .how__heading {
    margin: 1.25rem 0 0;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    color: var(--color-neutral-700);
    text-wrap: balance;
  }

  .how {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    align-items: start;
  }

  /* Vertical connected rail */
  .how__rail {
    position: relative;
    display: grid;
    grid-template-rows: repeat(3, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    padding-block: 0.5rem;
    align-self: stretch;
  }
  .how__rail-line {
    position: absolute;
    inset-block: 1.4rem;
    inset-inline-start: 1.25rem;
    inline-size: 2px;
    background: var(--color-neutral-200);
    border-radius: 2px;
    overflow: hidden;
  }
  .how__rail-fill {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 100%;
    background-image: var(--grad-signature);
    transform: scaleY(1);
    transform-origin: top center;
    transition: transform 0.4s ease;
  }
  .how__rail-node {
    position: relative;
    z-index: 1;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-navy);
    color: var(--color-white);
    box-shadow: var(--shadow-2);
    border: 2px solid var(--color-bg-light);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background-color 0.3s ease;
  }
  .how__rail-num {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 1rem;
  }

  .how__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 4vw, 3.25rem);
  }
  .how__step {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .how__step-eyebrow {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-orange);
    margin-block-end: 0.6rem;
  }
  :global([dir='rtl']) .how__step-eyebrow {
    font-family: var(--font-arabic);
    text-transform: none;
    letter-spacing: 0;
  }
  .how__step-title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.3rem, 2.4vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--color-navy);
  }
  .how__step-body {
    margin: 0;
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.7;
    color: var(--color-neutral-600);
    max-inline-size: 40rem;
  }

  /* ---- Enhanced (pinned) state, set by motion.ts on desktop + motion ---- */
  .how.is-enhanced .how__step {
    opacity: 0.32;
  }
  .how.is-enhanced .how__step.is-active {
    opacity: 1;
  }
  .how.is-enhanced .how__rail-node {
    background: var(--color-neutral-300);
  }
  .how.is-enhanced .how__rail-node.is-active {
    background: var(--color-navy);
    transform: scale(1.12);
    box-shadow: 0 0 0 6px rgba(6, 115, 255, 0.18), var(--shadow-3);
  }
  .how.is-enhanced .how__rail-node.is-done {
    background: var(--color-action);
  }

  @media (max-width: 760px) {
    .how__rail {
      gap: 0;
      display: none;
    }
    .how {
      grid-template-columns: 1fr;
    }
    .how__step {
      padding-inline-start: 1rem;
      border-inline-start: 2px solid var(--color-neutral-200);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .how__rail-node,
    .how__step,
    .how__rail-fill {
      transition: none;
    }
  }
</style>
