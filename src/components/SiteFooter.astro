---
import type { Copy, Locale } from '../i18n/copy';
import { site } from '../i18n/copy';
import { localeHome, anchor } from '../i18n/utils';
import Wordmark from './Wordmark.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { locale, c } = Astro.props;

// Match SiteNav: pure `#hash` on the locale's home page, absolute elsewhere.
const home = localeHome(locale);
const norm = (p: string) => p.replace(/\/+$/, '') || '/';
const onHome = norm(Astro.url.pathname) === norm(home);
const sectionHref = (id: string) => (onHome ? anchor(id) : `${home}${anchor(id)}`);

const links = [
  { label: c.nav.links.whatWeSolve, href: sectionHref(site.anchors.whatWeSolve) },
  { label: c.nav.links.whoItsFor, href: sectionHref(site.anchors.whoItsFor) },
  { label: c.nav.links.howItWorks, href: sectionHref(site.anchors.howItWorks) },
];
---

<footer class="footer on-navy">
  <div class="footer__inner">
    <div class="footer__brand">
      <Wordmark href={localeHome(locale)} ariaLabel={c.ui.home} size="md" />
      <p class="footer__tagline">{c.footer.tagline}</p>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">{c.footer.quickLinksLabel}</h2>
      <ul class="footer__links">
        {links.map((l) => (
          <li><a href={l.href} class="footer__link">{l.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer__col">
      <h2 class="footer__heading">{c.footer.contactLabel}</h2>
      <a href={site.contactHref} class="footer__contact">{site.contactEmail}</a>
    </div>
  </div>

  <div class="footer__legal-row">
    <p class="footer__legal">{c.footer.legal}</p>
    <div class="footer__legal-links">
      <a href={site.legal.privacy} class="footer__legal-link">{c.footer.privacy}</a>
      <span class="footer__legal-dot" aria-hidden="true">·</span>
      <a href={site.legal.terms} class="footer__legal-link">{c.footer.terms}</a>
    </div>
  </div>

  <div class="footer__bar grad-signature" aria-hidden="true"></div>
</footer>

<style>
  .footer {
    position: relative;
    background-color: var(--color-navy-dark);
    color: rgba(255, 255, 255, 0.72);
    padding-block-start: clamp(3rem, 6vw, 4.5rem);
  }
  .footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }
  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .footer__tagline {
    margin: 0;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.62);
    max-inline-size: 22rem;
  }
  .footer__heading {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-sky);
  }
  :global([dir='rtl']) .footer__heading {
    font-family: var(--font-arabic);
    letter-spacing: 0.02em;
    text-transform: none;
  }
  .footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .footer__link,
  .footer__contact {
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.98rem;
    transition: color 0.15s ease;
  }
  .footer__link:hover,
  .footer__contact:hover {
    color: var(--color-white);
  }
  .footer__contact {
    font-family: var(--font-mono);
    word-break: break-word;
  }

  .footer__legal-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
    padding-block: 1.5rem 2rem;
    border-block-start: 1px solid rgba(255, 255, 255, 0.08);
  }
  .footer__legal {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }
  .footer__legal-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .footer__legal-link {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    transition: color 0.15s ease;
  }
  .footer__legal-link:hover {
    color: var(--color-white);
  }
  .footer__legal-dot {
    color: rgba(255, 255, 255, 0.35);
  }

  .footer__bar {
    block-size: 3px;
    inline-size: 100%;
  }

  @media (min-width: 720px) {
    .footer__inner {
      grid-template-columns: 1.6fr 1fr 1fr;
      gap: 2rem;
    }
  }
</style>
