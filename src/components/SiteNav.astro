---
import type { Copy, Locale } from '../i18n/copy';
import { site } from '../i18n/copy';
import { localeHome, anchor } from '../i18n/utils';
import Wordmark from './Wordmark.astro';
import LangToggle from './LangToggle.astro';
import Button from './Button.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { locale, c } = Astro.props;

const links = [
  { label: c.nav.links.whatWeSolve, href: anchor(site.anchors.whatWeSolve) },
  { label: c.nav.links.whoItsFor, href: anchor(site.anchors.whoItsFor) },
  { label: c.nav.links.howItWorks, href: anchor(site.anchors.howItWorks) },
];
---

<header id="site-nav" class="nav on-navy" data-nav>
  <!-- Signature gradient bar = top-of-page scroll-progress indicator -->
  <div class="scroll-progress" aria-hidden="true">
    <div class="scroll-progress__fill grad-signature" data-progress></div>
  </div>

  <div class="nav__inner">
    <Wordmark href={localeHome(locale)} ariaLabel={c.ui.home} size="sm" />

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href} class="nav__link">{l.label}</a>)}
    </nav>

    <div class="nav__actions">
      <LangToggle locale={locale} c={c} />
      <Button href={site.signInUrl} variant="primary" external class="nav__signin">
        {c.nav.signIn}
      </Button>
      <button
        type="button"
        class="nav__burger"
        data-burger
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={c.ui.openMenu}
      >
        <span class="nav__burger-bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="nav__mobile" data-mobile data-close-label={c.ui.closeMenu} hidden>
    <nav class="nav__mobile-links" aria-label="Primary mobile">
      {links.map((l) => <a href={l.href} class="nav__mobile-link" data-mobile-link>{l.label}</a>)}
    </nav>
    <Button href={site.signInUrl} variant="primary" external class="nav__mobile-signin">
      {c.nav.signIn}
    </Button>
  </div>
</header>

<script>
  import { initNav } from '../scripts/nav';
  initNav();
</script>

<style>
  .nav {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 50;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, backdrop-filter 0.3s ease;
  }
  .nav.is-scrolled {
    background-color: rgba(8, 27, 66, 0.82);
    backdrop-filter: saturate(160%) blur(12px);
    -webkit-backdrop-filter: saturate(160%) blur(12px);
    box-shadow: var(--shadow-2);
    border-block-end: 1px solid rgba(255, 255, 255, 0.06);
  }

  .scroll-progress {
    position: absolute;
    inset-block-start: 0;
    inset-inline: 0;
    block-size: 3px;
    background: transparent;
  }
  .scroll-progress__fill {
    block-size: 100%;
    inline-size: 100%;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
    block-size: 4.25rem;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
  }
  .nav__link {
    font-size: 0.95rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    transition: color 0.15s ease;
  }
  .nav__link:hover {
    color: var(--color-white);
    opacity: 1;
  }
  .nav__link::after {
    content: '';
    display: block;
    block-size: 2px;
    inline-size: 0;
    margin-block-start: 3px;
    border-radius: 2px;
    background: var(--color-sky);
    transition: inline-size 0.22s ease;
  }
  .nav__link:hover::after,
  .nav__link.is-active::after {
    inline-size: 100%;
  }
  .nav__link.is-active {
    color: var(--color-white);
    opacity: 1;
  }
  .nav__mobile-link.is-active {
    color: var(--color-sky);
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .nav__signin {
    display: none;
  }

  /* Burger */
  .nav__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border-radius: var(--radius-md);
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
  }
  .nav__burger-bars,
  .nav__burger-bars::before,
  .nav__burger-bars::after {
    content: '';
    display: block;
    inline-size: 1.15rem;
    block-size: 2px;
    background: currentColor;
    color: var(--color-white);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .nav__burger-bars {
    position: relative;
  }
  .nav__burger-bars::before {
    position: absolute;
    inset-block-start: -6px;
    inset-inline-start: 0;
  }
  .nav__burger-bars::after {
    position: absolute;
    inset-block-start: 6px;
    inset-inline-start: 0;
  }
  .nav__burger[aria-expanded='true'] .nav__burger-bars {
    background: transparent;
  }
  .nav__burger[aria-expanded='true'] .nav__burger-bars::before {
    transform: translateY(6px) rotate(45deg);
  }
  .nav__burger[aria-expanded='true'] .nav__burger-bars::after {
    transform: translateY(-6px) rotate(-45deg);
  }

  /* Mobile menu panel */
  .nav__mobile {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.25rem clamp(1.25rem, 5vw, 3rem) 1.75rem;
    background-image: var(--grad-navy);
    border-block-start: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav__mobile[hidden] {
    display: none;
  }
  .nav__mobile-links {
    display: flex;
    flex-direction: column;
  }
  .nav__mobile-link {
    padding-block: 0.9rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-white);
    border-block-end: 1px solid rgba(255, 255, 255, 0.08);
  }
  .nav__mobile-signin {
    align-self: flex-start;
  }

  /* Desktop layout */
  @media (min-width: 880px) {
    .nav__links {
      display: flex;
    }
    .nav__signin {
      display: inline-flex;
    }
    .nav__burger,
    .nav__mobile {
      display: none !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__burger-bars,
    .nav__burger-bars::before,
    .nav__burger-bars::after {
      transition: none;
    }
  }
</style>
