---
// Section wrapper — owns vertical rhythm + light/navy theme so individual
// sections never fight over padding (the CSS-specificity footgun).
interface Props {
  id?: string;
  theme?: 'light' | 'navy' | 'navy-dark';
  glow?: boolean;
  vignette?: boolean;
  seam?: boolean;
  class?: string;
  innerClass?: string;
}
const {
  id,
  theme = 'light',
  glow = false,
  vignette = false,
  seam = false,
  class: className = '',
  innerClass = '',
} = Astro.props;

const isDark = theme === 'navy' || theme === 'navy-dark';
---

<section
  id={id}
  class:list={[
    'section',
    `section--${theme}`,
    { 'on-navy': isDark, 'section--vignette': vignette },
    className,
  ]}
>
  {seam && <span class="section__seam grad-signature" aria-hidden="true" />}
  {
    glow && isDark && (
      <div class="section__atmos" aria-hidden="true">
        <span class="glow section__glow section__glow--a" />
        <span class="glow section__glow section__glow--b" />
      </div>
    )
  }
  <div class:list={['section__inner', innerClass]}>
    <slot />
  </div>
</section>

<style>
  .section {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4rem, 9vw, 7.5rem);
    overflow: hidden;
  }
  .section__seam {
    position: absolute;
    inset-inline: 0;
    inset-block-start: 0;
    block-size: 2px;
    z-index: 2;
  }
  .section__inner {
    position: relative;
    z-index: 1;
    inline-size: 100%;
    max-inline-size: 1200px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 5vw, 3rem);
  }

  /* Themes */
  .section--light {
    background-color: var(--color-bg-light);
    color: var(--color-neutral-600);
  }
  .section--navy {
    background-image:
      radial-gradient(120% 85% at 82% -12%, rgba(40, 205, 252, 0.12), transparent 58%),
      radial-gradient(100% 80% at 0% 110%, rgba(6, 115, 255, 0.1), transparent 60%),
      var(--grad-navy);
    color: rgba(255, 255, 255, 0.82);
  }
  .section--navy-dark {
    background-color: var(--color-navy-dark);
    color: rgba(255, 255, 255, 0.82);
  }

  /* Faint film grain over dark sections for premium texture. */
  .section--navy::before,
  .section--navy-dark::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: var(--noise);
    background-size: 140px 140px;
    opacity: 0.05;
    mix-blend-mode: overlay;
  }

  /* Faint vignette to separate consecutive light sections */
  .section--vignette::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(
      120% 80% at 50% 0%,
      rgba(12, 40, 93, 0.04) 0%,
      rgba(12, 40, 93, 0) 60%
    );
  }

  /* Atmospheric glows for dark sections */
  .section__glow--a {
    inline-size: 38rem;
    block-size: 38rem;
    background: radial-gradient(circle, rgba(40, 205, 252, 0.16), transparent 70%);
    inset-block-start: -12rem;
    inset-inline-end: -10rem;
  }
  .section__glow--b {
    inline-size: 30rem;
    block-size: 30rem;
    background: radial-gradient(circle, rgba(6, 115, 255, 0.14), transparent 70%);
    inset-block-end: -14rem;
    inset-inline-start: -8rem;
  }
</style>
