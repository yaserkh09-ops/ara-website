---
import type { Copy, Locale } from '../i18n/copy';
import Hero from './sections/Hero.astro';
import WhatWeSolve from './sections/WhatWeSolve.astro';
import WhatAraDoes from './sections/WhatAraDoes.astro';
import WhoItsFor from './sections/WhoItsFor.astro';
import HowItWorks from './sections/HowItWorks.astro';
import BuiltOnTrust from './sections/BuiltOnTrust.astro';
import FinalCta from './sections/FinalCta.astro';

interface Props {
  locale: Locale;
  c: Copy;
}
const { locale, c } = Astro.props;
---

<Hero locale={locale} c={c} />
<WhatWeSolve locale={locale} c={c} />
<WhatAraDoes locale={locale} c={c} />
<WhoItsFor locale={locale} c={c} />
<HowItWorks locale={locale} c={c} />
<BuiltOnTrust locale={locale} c={c} />
<FinalCta locale={locale} c={c} />
